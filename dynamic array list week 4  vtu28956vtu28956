import java.util.*;

public class CollectionDemo {
    public static void main(String[] args) {

        // Dynamic Array
        ArrayList<Integer> numbers = new ArrayList<>();

        numbers.add(10);
        numbers.add(20);
        numbers.add(30);

        System.out.println("ArrayList: " + numbers);

        numbers.remove(1);
        System.out.println("After removal: " + numbers);
    }
}
