import java.util.HashMap;
import java.util.Map;

class UndergroundSystem {

    // Helper class to store check-in details for a customer
    private static class CheckInInfo {
        String stationName;
        int checkInTime;

        CheckInInfo(String stationName, int checkInTime) {
            this.stationName = stationName;
            this.checkInTime = checkInTime;
        }
    }

    // Helper class to track aggregate time and trip count between two stations
    private static class RouteData {
        double totalTime;
        int tripCount;

        RouteData(double totalTime, int tripCount) {
            this.totalTime = totalTime;
            this.tripCount = tripCount;
        }
    }

    // Map customer id -> active CheckInInfo
    private final Map<Integer, CheckInInfo> checkInMap;
    
    // Map route string ("startStation->endStation") -> aggregate RouteData
    private final Map<String, RouteData> travelDataMap;

    public UndergroundSystem() {
        checkInMap = new HashMap<>();
        travelDataMap = new HashMap<>();
    }
    
    public void checkIn(int id, String stationName, int t) {
        checkInMap.put(id, new CheckInInfo(stationName, t));
    }
    
    public void checkOut(int id, String stationName, int t) {
        // Retrieve and remove customer check-in record
        CheckInInfo checkInInfo = checkInMap.remove(id);
        
        String routeKey = checkInInfo.stationName + "->" + stationName;
        int duration = t - checkInInfo.checkInTime;

        // Update total time and trip count for the specific route
        RouteData routeData = travelDataMap.getOrDefault(routeKey, new RouteData(0, 0));
        routeData.totalTime += duration;
        routeData.tripCount += 1;
        
        travelDataMap.put(routeKey, routeData);
    }
    
    public double getAverageTime(String startStation, String endStation) {
        String routeKey = startStation + "->" + endStation;
        RouteData routeData = travelDataMap.get(routeKey);
        
        return routeData.totalTime / routeData.tripCount;
    }
}
